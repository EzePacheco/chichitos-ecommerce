# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-secret-key
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=replace-with-access-token
MERCADO_PAGO_WEBHOOK_SECRET=replace-with-webhook-secret

# Google Maps Platform
GOOGLE_MAPS_API_KEY=replace-with-server-side-key
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-with-browser-key

# Delivery defaults
DELIVERY_BASE_RADIUS_KM=3
DELIVERY_EXTRA_STEP_KM=0.5
